<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>LibTessDotNet</RootNamespace>
    <BaseOutputPath>..\Build\</BaseOutputPath>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\LibTessDotNet\jhl dev key.snk</AssemblyOriginatorKeyFile>
    <Title>LibTessDotNet</Title>
    <Version>2.0.0</Version>
    <Product>LibTessDotNet</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LibTessDotNet\Sources\Dict.cs" Link="Dict.cs" />
    <Compile Include="..\LibTessDotNet\Sources\Geom.cs" Link="Geom.cs" />
    <Compile Include="..\LibTessDotNet\Sources\Mesh.cs" Link="Mesh.cs" />
    <Compile Include="..\LibTessDotNet\Sources\MeshUtils.cs" Link="MeshUtils.cs" />
    <Compile Include="..\LibTessDotNet\Sources\PriorityHeap.cs" Link="PriorityHeap.cs" />
    <Compile Include="..\LibTessDotNet\Sources\PriorityQueue.cs" Link="PriorityQueue.cs" />
    <Compile Include="..\LibTessDotNet\Sources\Sweep.cs" Link="Sweep.cs" />
    <Compile Include="..\LibTessDotNet\Sources\Tess.cs" Link="Tess.cs" />
  </ItemGroup>

</Project>
